# Nutmeg Task Tracker - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git!

# Database Configuration
DATABASE_TYPE=postgresql
POSTGRES_USER=nutmeg_user
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nutmeg_db

# For Railway deployment, use DATABASE_URL instead:
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Secret (change this to a random string in production!)
JWT_SECRET_KEY=your_jwt_secret_key_here_change_this_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# Application Settings
# PORT=8000
# DEBUG=False
