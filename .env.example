# ==========================================
# Nexus Task Tracker - Environment Template
# ==========================================

# Database Selection ("postgresql" or "sqlite")
DATABASE_TYPE=postgresql
SQLITE_DB_PATH=./nexus.db
DB_ECHO=false

# PostgreSQL Connection Settings
POSTGRES_USER=nexus_user
POSTGRES_PASSWORD=nexus123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=nexus_db

# Optional Direct Database URL (Render / Railway / Supabase / Neon)
# DATABASE_URL=postgresql://nexus_user:nexus123@localhost:5432/nexus_db

# JWT Authentication
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# Security & Master Password Flags
DEFAULT_PASSWORD=nexus123
ALLOW_MASTER_PASSWORD_LOGIN=true

# CORS Configuration (comma-separated origins or *)
CORS_ORIGINS=*

# Docker Port Mappings (Optional)
FRONTEND_PORT=80
BACKEND_PORT=8000
